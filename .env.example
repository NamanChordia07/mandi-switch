# =====================================================================
# Mandi configuration. Copy to .env with:   python scripts/init_env.py
# (init_env.py fills every CORE_TOKEN_* with a fresh random value.)
# .env is git-ignored. Never commit real keys.
# =====================================================================

# ---------- LLM (custom agents: intake, quotes, negotiators, vendors) ----------
# OpenAI API key used by Mandi's custom Python agents (wording + evidence-checked extraction only;
# code decides every number). A small model keeps a full demo run at about one US cent.
OPENAI_API_KEY=
MANDI_OPENAI_MODEL=gpt-4o-mini
# Hard cap on LLM calls per process (cached repeats are free and don't count).
MANDI_LLM_MAX_CALLS=80
# Set to 1 to run without any LLM calls (deterministic template wording only).
MANDI_OFFLINE_LLM=0

# ---------- Switch ----------
# The Switch server address (the "Server address" Switch Console shows).
# A Switch Console local server picks its own port; copy it from Console.
SWITCH_BASE_URL=http://127.0.0.1:8000
# Registration keys, one per OWNER (Gateway -> API Keys -> Create Registration Key,
# created while signed in as that owner). The key's creator owns every agent it registers.
REGKEY_MANDI_OPS=
REGKEY_ASHA=
REGKEY_SANJAY=
REGKEY_KARAN=
# Switch admin login (Gateway). Used only by bootstrap_switch.py to apply the agents' "who can talk to me"
# policies through the Gateway API. Leave empty to apply them by hand in Switch Console instead.
SWITCH_ADMIN_EMAIL=
SWITCH_ADMIN_PASSWORD=

# ---------- Mattermost (bundled with Switch Console's local server) ----------
MATTERMOST_URL=http://127.0.0.1:8065
MATTERMOST_ADMIN_USER=
MATTERMOST_ADMIN_PASSWORD=
MATTERMOST_TEAM=
# Switch Console's bundled Mattermost: personas are created with `mmctl --local` in this container
MATTERMOST_CONTAINER=
# Optional: persona -> Mattermost username overrides (defaults: rohan, meera, vikram, asha, sanjay, karan)
# MM_USER_ROHAN=rohan

# ---------- Mandi Core ----------
CORE_HOST=127.0.0.1
CORE_PORT=8700
CORE_URL=http://127.0.0.1:8700
# Static bearer tokens, one per caller class. init_env.py generates them.
CORE_TOKEN_AGENTS=
CORE_TOKEN_VENDOR_DECCAN=
CORE_TOKEN_VENDOR_GANESH=
CORE_TOKEN_VENDOR_APEX=
CORE_TOKEN_MCP_PURCHASE_DESK=
CORE_TOKEN_MCP_PO_ISSUER=
CORE_TOKEN_UI=
CORE_TOKEN_DIRECTOR=

# ---------- Scenario ----------
# Scenario date "T". Empty = today (local). Format YYYY-MM-DD.
MANDI_SCENARIO_DATE=
# Seed for any randomness (wording variety only; numbers are always code-decided).
MANDI_SEED=147

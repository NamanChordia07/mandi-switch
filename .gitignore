# --- secrets (never commit) ---
.env
.env.*
!.env.example
secrets/*
!secrets/README.md
*.local.json
*.local.txt
*.pem
*.key

# --- runtime state ---
.state/
logs/
*.db
*.db-journal
*.sqlite
data/

# --- reference clones / scratch ---
vendor-ref/
_cleanclone/

# --- python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/

# --- node / ui ---
node_modules/
ui/dist/
ui/.vite/
ui/test-results/
ui/playwright-report/

# --- generated artifacts (regenerate with scripts) ---
seed/quotes/*.pdf
seed/quotes/*.png
generated/

# --- claude code per-machine state inside gate agent dirs ---
agents/gates/*/.switch/
agents/gates/*/.claude/settings.local.json

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# per-machine (generated by scripts/setup_gates.py)
agents/gates/*/.mcp.json
agents/gates/*/.claude/settings.json
